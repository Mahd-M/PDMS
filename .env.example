# Copy this file to .env and fill in real values. Never commit .env itself.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())" 
DJANGO_SECRET_KEY="replace with output from the above command"
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY="replace with output from the above command"

# Set to true only once you are running behind TLS (reverse proxy or otherwise)
DJANGO_USE_TLS=false
